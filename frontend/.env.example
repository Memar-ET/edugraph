# Base URL the browser uses to reach the Go core API.
# Leave unset for local `npm run dev` -- the Vite dev server proxies
# relative /api and /ws requests to API_PROXY_TARGET (see vite.config.ts),
# so the browser never needs an absolute API URL in that mode.
# Set explicitly for a docker-compose or non-proxied deployment, e.g.
# VITE_API_URL=http://localhost:8080/api/v1
VITE_API_URL=

# Vite dev-server-only: where /api and /ws requests are proxied to.
# Local `npm run dev` (outside Docker): http://localhost:8080
# Inside docker-compose (frontend container reaching the api container
# over the compose network): http://api:8080
API_PROXY_TARGET=http://localhost:8080
