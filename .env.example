# ── POSTGRES (Supabase session pooler by default -- see Project Settings ->
# Database -> Connection Pooling -> "Session mode" in your Supabase project.
# Use the pooler host/user, not the direct db.<ref>.supabase.co one: that
# one is IPv6-only and unreachable from most networks. To use a plain local
# Postgres instead, set HOST=localhost, USER/DB=edugraph, SSLMODE=disable.) ─
POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=changeme
POSTGRES_SSLMODE=require
POSTGRES_MAX_CONNS=15

# ── SUPABASE (project-level; not currently used by any code path) ───────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── NEO4J ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_MAX_CONN_POOL_SIZE=50

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_S3_CURRICULUM_BUCKET=edugraph-curriculum-docs
AWS_S3_EXAM_BUCKET=edugraph-exam-files
AWS_S3_REPORTS_BUCKET=edugraph-reports
AWS_S3_AUDIT_BUCKET=edugraph-audit-logs

# ── AI SERVICE ────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# checklist 8.1: "local" (default) uses Ollama everywhere text generation
# happens (gap analysis, tutor, study plans, exam CLO matching); "cloud"
# swaps in Gemini as primary instead. Whichever isn't primary is still
# tried as a fallback -- see ai-service/app/utils/llm_provider.py.
LLM_PROVIDER=local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Embedding provider for CLO/topic vectors written on curriculum approval.
# sentence_transformers – local Hugging Face model (default: intfloat/multilingual-e5-large, 1024-dim)
# ollama                – Ollama nomic-embed-text via OLLAMA_HOST; falls back to stub
# stub                  – deterministic hash placeholder (dev/test fallback)
EMBEDDING_PROVIDER=sentence_transformers
# The cloud provider option for LLM_PROVIDER above. Also used by the
# Gemini-backed CLO matcher (exam_parser/clo_matcher_llm.py) as a
# fallback tier regardless of LLM_PROVIDER. Empty means "not configured"
# -- every caller treats that as unavailable and falls back.
GEMINI_API_KEY=

# ── TELEMETRY ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ── APP ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
