# ── POSTGRES ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edugraph
POSTGRES_USER=edugraph
POSTGRES_PASSWORD=changeme
POSTGRES_MAX_CONNS=80

# ── NEO4J ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_MAX_CONN_POOL_SIZE=50

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ── AWS ───────────────────────────────────────────────────────
AWS_REGION=af-south-1
AWS_S3_CURRICULUM_BUCKET=edugraph-curriculum-docs
AWS_S3_EXAM_BUCKET=edugraph-exam-files
AWS_S3_REPORTS_BUCKET=edugraph-reports
AWS_S3_AUDIT_BUCKET=edugraph-audit-logs

# ── AI SERVICE ────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Capability 2A: Gemini-backed CLO matcher (exam_parser/clo_matcher_llm.py).
# Falls back to the plain keyword matcher if this is unset.
GEMINI_API_KEY=

# ── TELEMETRY ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ── APP ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
