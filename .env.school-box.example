# School Box Sync Agent — environment template
# Copy to .env.school-box and fill in values for each School Box device.
# NEVER commit .env.school-box to source control — it contains device secrets.
#
# Provision a device credential with:
#   POST /api/v1/admin/sync/devices  (ministry_admin)
#   Body: {"deviceId": "...", "schoolId": "...", "secret": "..."}
# The API stores the secret bcrypt-hashed; this file holds the plaintext.

# ── Cloud API ──────────────────────────────────────────────────────────────
# Base URL of the cloud EduGraph API (no trailing slash).
CLOUD_API_URL=https://api.edugraph.et

# ── Device credentials ─────────────────────────────────────────────────────
# Unique opaque identifier for this School Box unit (e.g. "sb-addis-001").
DEVICE_ID=sb-school-001

# Secret provisioned for this device. Stored bcrypt-hashed in the cloud DB.
# A leaked credential for School A cannot be used for School B's data because
# the cloud handler cross-checks the device_id against its school_id.
DEVICE_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# UUID of the school this device belongs to. Must match the device_credentials
# row in the cloud DB — the cloud enforces this, not just the agent.
SCHOOL_ID=00000000-0000-0000-0000-000000000000

# ── Local Postgres ─────────────────────────────────────────────────────────
# If LOCAL_POSTGRES_DSN is set it takes precedence over the POSTGRES_* vars.
LOCAL_POSTGRES_DSN=

# Alternatively, set individual components (used if LOCAL_POSTGRES_DSN is empty):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edugraph
POSTGRES_USER=edugraph
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
POSTGRES_SSLMODE=disable

# ── Sync behaviour ─────────────────────────────────────────────────────────
# How often to run a push+pull cycle (seconds). Default 60.
SYNC_INTERVAL_SECONDS=60

# Address for the health HTTP server. Default :8081.
HEALTH_ADDR=:8081
